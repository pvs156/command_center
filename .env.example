# Copy to .env (ignored by git). No keys are needed for public job feeds or extractive mode.
# Claude powers resume rewriting when "Claude" is selected in Preferences.
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5. claude-sonnet-5-5 costs about half per token.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Optional alternative provider.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b


# Free Gemini key from https://aistudio.google.com ("Get API key"). Powers resume writing, outreach and people search.
GEMINI_API_KEY=
